NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Claude does job analysis, query generation, location checks and scoring.
ANTHROPIC_API_KEY=
# Only needed if the key above isn't scoped to a workspace (the API says so
# with a 400). Prefer a workspace-scoped key instead.
ANTHROPIC_WORKSPACE_ID=
# Optional: defaults to claude-haiku-5-5. Pricing for other models lives in
# src/lib/providers/pricing.ts.
ANTHROPIC_MODEL=
# Optional: a different model for candidate scoring only, e.g. claude-sonnet-5-5.
ANTHROPIC_MATCH_MODEL=
SERPAPI_API_KEY=
SERPER_API_KEY=
SEARCH_PROVIDER=mock
# Optional: enables LinkedIn profile enrichment between SerpApi discovery and
# AI matching. Leave both blank to skip enrichment entirely (SerpApi-only
# data flows straight to matching, as before). If you set one, set both.
APIFY_API_TOKEN=
# Apify actor id, using "~" (not "/") as the owner/name separator, e.g.
# harvestapi/linkedin-profile-scraper -> harvestapi~linkedin-profile-scraper
APIFY_ACTOR_ID=harvestapi~linkedin-profile-scraper

# Search credits (header counter). Limits are shared by everyone running on
# the same provider API keys; admins edit them in the counter's panel.
# Optional: name the budget so a key rotation keeps the same history.
USAGE_TENANT=
# Optional: HarvestAPI has no balance API; set the prepaid amount (USD) to
# show what's left (prepaid minus our measured spend).
HARVESTAPI_PREPAID_USD=1

# Link back to HR Portal (shown in the nav) and single sign-on with it.
# Production: NEXT_PUBLIC_HR_PORTAL_URL=https://careers.thegdevelopments.com
# and NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.thegdevelopments.com (same value in HR
# Portal). Leave both blank locally. NEXT_PUBLIC_* is inlined at build time, so
# set them in Vercel before deploying.
NEXT_PUBLIC_HR_PORTAL_URL=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# WhatsApp number for the nav's support chat button: digits only, country
# code first. Defaults to 201099359799 when unset.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
